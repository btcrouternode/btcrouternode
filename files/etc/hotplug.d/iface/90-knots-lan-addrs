#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# S11 (review 2026-10-10) — keep /etc/knots/nginx-lan-addrs.map in step with
# the router's public (GUA) IPv6 addresses on the LAN bridge, so nginx can
# tell a LAN request from a WAN one by the address it arrived on.
# Prefix delegation changes arrive as ifupdate, so handle both.
case "$ACTION" in ifup|ifupdate) ;; *) exit 0 ;; esac
[ "$INTERFACE" = "lan" ] || exit 0

MAP=${KNOTS_LAN_MAP:-/etc/knots/nginx-lan-addrs.map}
dev=$(ubus call network.interface.lan status 2>/dev/null | \
	sed -n 's/.*"l3_device"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
[ -n "$dev" ] || dev=br-lan

tmp="$MAP.$$"
{
	echo "# generated by 90-knots-lan-addrs — do not edit"
	# ULA (fc00::/7) is already matched by the map's own regex — listing it
	# here only changed the file (→ nginx reload) on every boot / prefix
	# event. A reload closes idle keep-alive connections, and a browser POST
	# sent on one just then fails ("Failed to fetch", .86 Guided Node step).
	ip -6 -o addr show dev "$dev" scope global 2>/dev/null | \
		awk '{ split($4, a, "/"); if (tolower(a[1]) !~ /^f[cd]/) print "\"" a[1] "\" 1;" }' | sort -u
} >"$tmp" || { rm -f "$tmp"; exit 0; }

if cmp -s "$tmp" "$MAP"; then
	rm -f "$tmp"
	exit 0
fi
mv -f "$tmp" "$MAP"
/usr/libexec/knots/nginx-apply.sh
exit 0
