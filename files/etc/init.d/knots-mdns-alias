#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# N20 unit name over mDNS: publish rnode-XXXX.local (this unit's own name, on
# its label) for the LAN IP, as an ALIAS without a reverse (PTR) record.
# avahi's static hosts file cannot do this: an entry for the router's own
# address collides with the host name's reverse record ("Local name
# collision", found on hardware .103 — the name was never announced).
# avahi-publish -R keeps the registration while it runs; procd respawns it when
# avahi-daemon restarts (95-knots-avahi restarts both on every LAN ifup).

START=62
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/bin/avahi-publish ] || return 0
	[ -f /usr/libexec/knots/unit-name.sh ] || return 0
	. /usr/libexec/knots/unit-name.sh
	unit=$(knots_unit_name 2>/dev/null)
	ip=$(uci -q get network.lan.ipaddr)
	[ -n "$unit" ] && [ -n "$ip" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/avahi-publish -a -R "$unit.local" "$ip"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
