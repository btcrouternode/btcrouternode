#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Refresh /tmp/knots/status.json for node UI /api/status

START=96
STOP=10
USE_PROCD=1

NAME=knots-status
PROG=/usr/libexec/knots/status-api.sh

start_service() {
	mkdir -p /tmp/knots
	# Stub: initialising, never a hard RPC error before first poll
	if [ ! -f /tmp/knots/status.json ]; then
		echo starting >/tmp/knots/knots.status 2>/dev/null || true
		cat >/tmp/knots/status.json <<'EOF'
{"product_version":"unknown","build_number":"unknown","hostname":"node-router","node_impl":"core","maintenance":{"active":true,"op":"initializing","message":"Node is initialising — starting Bitcoin. Status will update when ready."},"knots":{"running":false,"verification_progress":0,"blocks":0,"headers":0,"best_block_hash":"","peers":0,"uptime_sec":0,"error":null},"storage":{"mounted":false,"path":"/mnt/bitcoin","free_bytes":0,"low_space":false}}
EOF
	fi

	procd_open_instance
	procd_set_param command /bin/sh -c \
		'while true; do /usr/libexec/knots/lxc-ensure.sh attach-veth || true; /usr/libexec/knots/disk-health.sh --if-stale 300 || true; /usr/libexec/knots/m2-trim.sh || true; /usr/libexec/knots/status-api.sh || true; /usr/libexec/knots/led-status.sh || true; sleep 15; done'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
