#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# R13/P1 — factory admin password (label secret, else knotsnode21) on *first boot only*.
#
# After keep-config sysupgrade (-v), OpenWrt restores /etc/shadow via keep.d but
# uci-defaults whiteouts are NOT kept — this script reappears from /rom and must
# NOT overwrite a user password preserved in the overlay backup.

# Setup / IUE already chose a password (markers kept via keep.d/knots).
if [ -f /etc/knots/setup-complete ] || [ -f /etc/knots/setup-password-done ]; then
	exit 0
fi

# Shadow already has a real password (keep-config upgrade or LuCI change).
root_hash=$(grep '^root:' /etc/shadow 2>/dev/null | cut -d: -f2)
case "$root_hash" in
	''|'!'|'*') ;;
	*) exit 0 ;;
esac

# P1 (review 2026-10-10): the label's per-device secret when provisioned,
# else the legacy shared password (unlabelled units: Wi-Fi stays off).
# shellcheck disable=SC1091
. /usr/libexec/knots/setup-lib.sh 2>/dev/null || true
if command -v knots_factory_password >/dev/null 2>&1; then
	PASS=$(knots_factory_password)
else
	PASS='knotsnode21'
fi

printf '%s\n%s\n' "$PASS" "$PASS" | passwd root >/dev/null 2>&1 || {
	if command -v chpasswd >/dev/null 2>&1; then
		printf 'root:%s\n' "$PASS" | chpasswd >/dev/null 2>&1
	fi
}

exit 0
