# SPDX-License-Identifier: GPL-2.0-only
# Sourced by Makefile
# PRODUCT_VER = {openwrt}.{core}.{build} — follows Bitcoin Core, the default node
# (docs/RELEASE_PROCESS.md; Release 1 = .118 still used the Knots version).
# Bitcoin Knots was dropped in build 120: Core is the only node software.
OPENWRT_VER := 24.10.8
BUILD_NUM := 120
# Supply-chain pins (C4): SHA256 of the exact release tarballs. Update together
# with the version tags; verify against the publisher's signed checksums when bumping.
CORE_VER := 32.1
CORE_TAG := v32.1
CORE_SHA256 := 7ed37c7373eb6aa3e3f72842596a1afeba1b223717033cade9842b25773e1922
PRODUCT_VER := $(OPENWRT_VER).$(CORE_VER).$(BUILD_NUM)
# X5: LXC rootfs base image pinned by digest (multi-arch index incl. arm64).
DEBIAN_IMAGE := debian:bookworm@sha256:268fb24c39bca92d326dd83ea3abebe4a3f7751c804ffef23bb6d857dd343ff8
IB_SHA256 := cbf7b0914991f1462fa52de592fa515faeaafce7ccbca075a0363162524e991b
PROFILE := bananapi_bpi-r4
IB_NAME := openwrt-imagebuilder-24.10.8-mediatek-filogic.Linux-x86_64
IB_URL := https://downloads.openwrt.org/releases/24.10.8/targets/mediatek/filogic/$(IB_NAME).tar.zst

# R5b: SD + eMMC production partition size (MiB). BPI-R4 8GTF4R user area is
# exactly 15269888 sectors (7456 MiB). Production GPT starts at 64 MiB; leave
# room for backup GPT → max MiB-aligned production = 7391 MiB. 7408 overflowed
# this eMMC (F28) and U-Boot rejected the table so menu-9 never wrote images.
# Same CONFIG_TARGET_ROOTFS_PARTSIZE for SD GPT and embedded eMMC GPT so lab SD
# emulates production eMMC (immutable squashfs + large fitrw overlay).
ROOTFS_PARTSIZE_MIB := 7391
